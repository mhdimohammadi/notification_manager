# ==========================================
# Django
# ==========================================
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# PostgreSQL
# ==========================================
DB_NAME=notification_manager
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=postgres
DB_PORT=5432

# ==========================================
# Celery
# ==========================================
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==========================================
# Email
# ==========================================
# Fernet key used to encrypt sensitive email configuration data.
# Generate a new key for your environment.
EMAIL_ENCRYPTION_KEY=your-fernet-encryption-key

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://redis:6379/1

# ==========================================
# MongoDB
# ==========================================
MONGODB_URL=mongodb://mongodb:27017/notification_log